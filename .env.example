# Provisioner: fake | local | vultr
PROVISIONER=fake

# Runtime: runsc (gVisor) | runc
RUNTIME=runc

# LLM: fake | ollama | openai | live
LLM_MODE=fake
# Executable codegen: llm (default) | heuristic | off  (incident kill-switch)
CODEGEN_MODE=llm
# OpenAI cloud (LLM_MODE=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Local Ollama (OpenAI-compatible). Used when LLM_MODE=ollama|local.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2:latest
OLLAMA_API_KEY=ollama
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_MODEL=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1

# Vultr API (provisioner=vultr)
VULTR_API_KEY=
VULTR_REGION=ewr
VULTR_PLAN=vc2-2c-4gb
VULTR_SNAPSHOT_ID=

# Control plane
CONTROL_PLANE_URL=http://127.0.0.1:8000
TOOLPAIN_DATA_DIR=./data
SCAN_TIMEOUT_SEC=1800
REAPER_MAX_AGE_MIN=30

# Bind address for make dev
HOST=0.0.0.0
PORT=8000
