# Production (Vultr CP): PROVISIONER=vultr + LLM_MODE=live + VULTR_INFERENCE_API_KEY
# Local offline tests only: PROVISIONER=demo + LLM_MODE=fixture
PROVISIONER=vultr

# Runtime: runsc (gVisor) | runc
RUNTIME=runc

# LLM: live (Vultr Inference, production) | ollama (laptop only) | fixture (offline tests ONLY)
LLM_MODE=live
# Executable codegen is always LLM on live scans. heuristic|off is ignored (legacy).
CODEGEN_MODE=llm
# Set on the CP: TOOLPAIN_ENV=prod|staging refuses fixture LLM / demo provisioner.
# TOOLPAIN_ENV=local
# Vultr Serverless Inference (production codegen + research)
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_MODEL=deepseek-v4.1-flash-1017
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Setup/launch/probe codegen model (defaults to VULTR_INFERENCE_MODEL)
CODEGEN_MODEL=qwen3.8-27b
# Local Ollama (/v1 chat). Used when LLM_MODE=ollama|local — laptop only.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2:latest
OLLAMA_API_KEY=ollama

# Vultr API (provisioner=vultr)
# On the control-plane VM this should be a *service-user* key IP-locked to that
# VM (minted by infra/bootstrap_cp_api_key.py). Keep your personal/bootstrap
# key off the CP — use VULTR_BOOTSTRAP_API_KEY only on your laptop for setup.
VULTR_API_KEY=
# Laptop-only: create/bake/bootstrap. Not used by the running CP.
# VULTR_BOOTSTRAP_API_KEY=
VULTR_REGION=ewr
VULTR_PLAN=vc2-2c-4gb
VULTR_SNAPSHOT_ID=

# Warm scanner pool capacity (off by default). When enabled, CP keeps N snapshot
# VMs ready. Scans only claim a pool VM when the intake toggle / use_pool=true
# is set (also off by default). Set a stable POOL_TOKEN.
# SCANNER_POOL_ENABLED=0
# SCANNER_POOL_SIZE=2
# SCANNER_POOL_TOKEN=

# Control plane
CONTROL_PLANE_URL=http://127.0.0.1:8000
TOOLPAIN_DATA_DIR=./data
SCAN_TIMEOUT_SEC=1800
REAPER_MAX_AGE_MIN=30

# Bind address for make dev
HOST=0.0.0.0
PORT=8000
